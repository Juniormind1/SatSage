.github
.grok
.idea
.venv
**/.venv
**/__pycache__
**/*.pyc
**/*.s9pk
**/*.pem
**/*.key
node_modules
packaging/node_modules
packaging/javascript
packaging/docker-images
packaging/.startos
packaging/assets
packaging/icon.png
packaging/satsage-splash.png
packaging/satsage-splash.meta.json
.startos
utxo_cache
immutable_cache
sanctioned_cache
label_cache
tor_data
psbt_out
tmp
lab
tests
specter_plugin
terminals
mcps
build
dist
deploy
scripts
githooks
*.egg-info
.env
.env.*
.satsage-password
.satsage-password.*

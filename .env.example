# ---------------------------------------------------------------------------
# Wallets — ein Block je Wallet, fortlaufend ab 0, ohne Luecke
# ---------------------------------------------------------------------------
# Die Nummerierung beginnt bei 0. Bei der ersten fehlenden Nummer endet die
# Liste: WALLET_0 und WALLET_2 ohne WALLET_1 ergibt genau ein Wallet.
#
# Namen duerfen Leerzeichen enthalten — jedes Feld steht fuer sich.

# WALLET_0_NAME=Mein Wallet
# WALLET_0_XPUB=zpub6DeinXPUB
# WALLET_0_SCRIPT=segwit          # auto|legacy|nested|segwit|taproot
# WALLET_0_MAX_ADDRESSES=50       # optional, sonst MAX_ADDRESSES

# WALLET_1_NAME=Zweites Wallet
# WALLET_1_XPUB=xpub6ZweiterXPUB
# WALLET_1_SCRIPT=auto

# Multisig: der Output-Deskriptor ist die gespeicherte Form. Nur er kann
# auch Taproot und Policies mit Zeitschloss (Liana) ausdruecken. Schluessel,
# Schwelle und Skripttyp werden daraus gelesen; die Pruefsumme hinter #
# gehoert zum Wert.
# WALLET_2_NAME=Tresor
# WALLET_2_DESC=wsh(sortedmulti(2,[fp/48h/0h/0h/2h]xpubA/<0;1>/*,...))#checksum
# WALLET_2_MAX_ADDRESSES=50
#
# Taproot-Multisig:
# WALLET_2_DESC=tr(xpubA/<0;1>/*,multi_a(2,xpubB/<0;1>/*,xpubC/<0;1>/*))
#
# Kurzform als Eingabe — wird beim Speichern in einen Deskriptor uebersetzt.
# Kann nur sortedmulti in wsh oder sh-wsh; fuer Taproot _DESC benutzen.
# WALLET_2_NAME=Tresor
# WALLET_2_M=2
# WALLET_2_SCRIPT=wsh             # wsh|sh-wsh
# WALLET_2_XPUBS=xpub6A xpub6B xpub6C

# Alte Schreibweise (wird weiter gelesen, beim Speichern aber umgewandelt):
# XPUBS=zpub6DeinXPUB zpub6ZweiterXPUB
# WALLET_NAMES=Mein Wallet|Zweites Wallet

# Fulcrum / Electrum
# main.py: eigener Node (LAN/Tor) zuerst, sonst Rotation FULCRUM_TOR_0…9
# check_fulcrum_tor.py: testet Verbindungen und schlaegt passende Werte vor
FULCRUM_HOST=192.168.1.100
FULCRUM_TOR=abc123def456789abcdefghijklmnopqrstuvwxyz.onion
FULCRUM_PORT=50002
FULCRUM_SSL=true
# Start9 Tor (oft abweichend von LAN): Port/SSL aus StartOS → Fulcrum → Verbinden
# FULCRUM_TOR_PORT=50001
# FULCRUM_TOR_SSL=false

# Schneller Clearnet-Fulcrum nur fuer Sanktionslisten (OFAC, ohne eigene XPUBs)
# Leer = automatisch schnellster Server aus electrum_servers.json
# FULCRUM_SANCTIONS_HOST=fulcrum.sethforprivacy.com
# FULCRUM_SANCTIONS_PORT=50002
# FULCRUM_SANCTIONS_SSL=true
# Leer: bis zu 8 schnelle Clearnet-Server aus electrum_servers.json (parallel)

# Oeffentliche Onion-Server fuer Rotation (von check_fulcrum_tor.py, max. 10)
# FULCRUM_TOR_PROXY=127.0.0.1:9150
# FULCRUM_TOR_0=beispiel1.onion
# FULCRUM_PORT_0=50002
# FULCRUM_SSL_0=true
# FULCRUM_TOR_1=beispiel2.onion
# FULCRUM_PORT_1=50002
# FULCRUM_SSL_1=true

# Tor-SOCKS (optional). Laeuft keiner, startet SatSage ein lokales tor
# (Binary aus dem Tor-Browser-Ordner, ohne Browser-Fenster).
# FULCRUM_TOR_PROXY=127.0.0.1:9050
# TOR_BINARY=/Applications/Tor Browser.app/Contents/MacOS/Tor/tor
# TOR_BINARY=C:\Pfad\zu\tor.exe
# TOR_AUTOSTART=0

# Bitcoin Core RPC — für schnelleren UTXO-Scan (scantxoutset), optional.
# LAN oder Onion (Start9: RPC über Tor). Passwort nicht committen.
# NODE_IP=192.168.1.50
# NODE_IP=xxxxxxxxxxxxxxxx.onion
# RPCPORT=8332
# RPCUSER=bitcoinrpc
# RPCPASSWORD=
# RPC_SSL=false
# Bei Onion-RPC denselben SOCKS wie unten (FULCRUM_TOR_PROXY).

# Compact Filter über Bitcoin-P2P. Auto-Kette nach eigenem Electrum-Server
# und optional Core-RPC. Abschalten: BIP158_P2P=0
# BIP158_P2P=1
# BIP158_START_HEIGHT=481824
# Feste extra Peers (sonst: Host im LAN zuerst, dann DNS-Seeds):
# BIP158_PEERS=
# Öffentliche Electrum-Server (Onion/Clearnet) nur nach Bestätigung:
# OEFFENTLICHE_ELECTRUM=0

# Assistent (LLM) — Loopback ohne Key; Remote nur mit LLM_REMOTE_OPT_IN=1
# und einem eigens gesetzten LLM_API_KEY (optionaler Alias XAI_API_KEY in dieser Datei).
# Den Key der laufenden Grok-Sitzung nicht hierher kopieren. Key nie committen.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODELL=llama3.2
# LLM_ANBIETER=ollama
# LLM_ANBIETER=lmstudio
# LLM_ANBIETER=api-key
# LLM_API_KEY=
# Optional Alias: XAI_API_KEY=
# Remote/LAN erst nach bewusster Freigabe (Analog OEFFENTLICHE_ELECTRUM):
# LLM_REMOTE_OPT_IN=0
# Optionale Deklaration (widerspricht die URL, gewinnt die Heuristik bei
# „loopback“-Anspruch auf Remote-URL):
# LLM_BETRIEB=loopback

# Beim Start: Wallets mit Cache bis Chain-Tip nachziehen (Gap fortsetzen,
# kein Fullscan). Vorgabe aus.
# WALLETS_BEIM_START_AKTUALISIEREN=0

# Status-Mails (neutral: nur Ereignis/Status/Zeit — keine Wallet-/Scan-Daten).
# Opt-in erforderlich. SMTP lokal konfigurieren.
# STATUS_MAIL_OPT_IN=0
# STATUS_MAIL_TO=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=1

# Web-UI-Sprache: de (Default) oder en. Browser-localStorage kann überschreiben.
# UI_LANG=de

# Web-UI-Darstellung: light (Default) oder dark. Browser-localStorage kann überschreiben.
# UI_THEME=light

# Steuer: Haltefrist und Stichtagsregel
# Haltefrist in Jahren bis zur Steuerfreiheit. Vorgabe 1 (Deutschland, § 23 EStG).
# STEUER_HALTEFRIST_JAHRE=1
# Optionaler Cutoff (z. B. Österreich 28.02.2021, BMF-Altbestand). Leer oder
# auskommentiert: Haltefrist gilt für alle Anschaffungen.
# STEUER_STICHTAG=
# Anschaffung aus Herkunft: juengste = defensiv (Default), aelteste = offensiv.
# STEUER_ANSCHAFFUNG=juengste

# On-Chain-Hinweis im Einrichtungsdialog bestätigt (1 = nicht mehr zeigen).
# Die Oberfläche schreibt das nach OK + „Nicht nochmal anzeigen“.
# HINWEIS_ONCHAIN_BESTAETIGT=0

# Esplora (wenn gesetzt → Esplora; auskommentiert → Fulcrum/Rotation)
# ESPLORA_URL=https://mempool.space/api

# Start9/Auth (optional): Passwort niemals hier im Klartext speichern.
# Beim ersten Start über POST /api/auth/setup setzen; Hash liegt in
# .satsage-password neben dieser Datei (Mode 0600).
# SATSAGE_PASSWORD_FILE=/data/satsage/.satsage-password
# SATSAGE_TRUST_PROXY=1
# SATSAGE_HOST_ALLOWLIST=ui.start9.local,*.local,.onion

# Start9 / Outbound-Sicherheit
# SATSAGE_MANAGED_BY=start9 oder SATSAGE_START9=1 aktiviert den Dependency-Modus.
# SATSAGE_OUTBOUND_PUBLIC_OPT_IN=1 ist für öffentliche Clearnet-Ziele erforderlich.
# SATSAGE_TLS_INSECURE=1: Zertifikatsprüfung auch für öffentliche Hosts aus (Labor).
# LAN/Loopback/Onion brauchen das Flag nicht — dort bleibt Self-Signed erlaubt.
# BITCOIND_HOST=bitcoind
# ELECTRS_HOST=electrs
# Betrieb/DoS: maximal gleichzeitig laufende schwere Jobs (Default: 3).
# Bei voller Belegung antwortet die API mit HTTP 429; laufende Jobs bleiben abbrechbar.
# SATSAGE_MAX_PARALLEL_JOBS=3

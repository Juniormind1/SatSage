.env
# Die Web-Oberfläche legt vor jedem Schreiben eine Sicherung der .env an und
# schreibt über eine .tmp. Beide enthalten dieselben Geheimnisse wie die .env
# selbst — XPUBs, RPC-Zugangsdaten.
.env.bak
.env.tmp
.env.*.bak

__pycache__/
*.pyc
.venv/


#!/bin/sh
# SatSage Maintainer-Hook (core.hooksPath=githooks):
# 1) nur Juniormind1-Identität
# 2) keine bekannten Secret-Pfade im Commit
# Contributor-Clones setzen hooksPath nicht — eigene IDs OK; S1 gilt trotzdem.

set -e

REQUIRED_NAME="Juniormind1"
REQUIRED_EMAIL="juniormind@proton.me"

NAME="$(git config --get user.name || true)"
EMAIL="$(git config --get user.email || true)"
AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-$EMAIL}"
AUTHOR_NAME="${GIT_AUTHOR_NAME:-$NAME}"
COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-$EMAIL}"
COMMITTER_NAME="${GIT_COMMITTER_NAME:-$NAME}"

ok=1
[ "$NAME" = "$REQUIRED_NAME" ] || ok=0
[ "$EMAIL" = "$REQUIRED_EMAIL" ] || ok=0
[ "$AUTHOR_NAME" = "$REQUIRED_NAME" ] || ok=0
[ "$AUTHOR_EMAIL" = "$REQUIRED_EMAIL" ] || ok=0
[ "$COMMITTER_NAME" = "$REQUIRED_NAME" ] || ok=0
[ "$COMMITTER_EMAIL" = "$REQUIRED_EMAIL" ] || ok=0

if [ "$ok" -ne 1 ]; then
  echo "ERROR: SatSage allows only $REQUIRED_NAME <$REQUIRED_EMAIL>." >&2
  echo "Config/author/committer must all match that identity." >&2
  echo "Fix:" >&2
  echo "  git config user.name $REQUIRED_NAME" >&2
  echo "  git config user.email $REQUIRED_EMAIL" >&2
  echo "  git config core.hooksPath githooks" >&2
  echo "  unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL" >&2
  exit 1
fi

# S1: block known secret pathnames in the staged set (added/modified/copied).
# Deletions are allowed so cleanup commits can land.
# Allow templates: .env.example, .regtest.env.example, *.env.example
blocked=""
while IFS= read -r path; do
  [ -z "$path" ] && continue
  base="${path##*/}"
  case "$base" in
    .env.example|*.env.example|.regtest.env.example) continue ;;
    .env|.env.bak|.env.tmp|.env.gobbledigook|.env.gobbledigook.tmp) ;;
    .env.backup[0-9]|.env.backup[0-9][0-9]) ;;
    .satsage-password|.satsage-password.tmp) ;;
    .env.*)
      # other .env.* sidecars (scrambled backups, local overlays) — block
      ;;
    *) continue ;;
  esac
  blocked="${blocked}${path}
"
done <<EOF
$(git diff --cached --name-only --diff-filter=ACMR || true)
EOF

if [ -n "$(printf '%s' "$blocked" | tr -d '[:space:]')" ]; then
  echo "ERROR: refusing commit — secret path(s) staged (S1 / AGENTS.md HART):" >&2
  printf '%s' "$blocked" | sed '/^$/d;s/^/  /' >&2
  echo "Unstage: git rm --cached -- <path>  and keep it in .gitignore." >&2
  exit 1
fi

exit 0

#!/bin/sh
# SatSage: block personal identities from entering public commit metadata.
# Activate once per clone: git config core.hooksPath githooks

set -e

NAME="$(git config --get user.name || true)"
EMAIL="$(git config --get user.email || true)"
AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-$EMAIL}"
AUTHOR_NAME="${GIT_AUTHOR_NAME:-$NAME}"
COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-$EMAIL}"
COMMITTER_NAME="${GIT_COMMITTER_NAME:-$NAME}"

blob="$(printf '%s\n' "$NAME" "$EMAIL" "$AUTHOR_NAME" "$AUTHOR_EMAIL" "$COMMITTER_NAME" "$COMMITTER_EMAIL" | tr '[:upper:]' '[:lower:]')"

case "$blob" in
  **|*\ *|*" "*|*@protonmail.com*)
    echo "ERROR: personal identity detected in git author/committer fields." >&2
    echo "This public SatSage repo must use Juniormind1 <juniormind@proton.me> only." >&2
    echo "Fix:" >&2
    echo "  git config user.name Juniormind1" >&2
    echo "  git config user.email juniormind@proton.me" >&2
    echo "  git config core.hooksPath githooks" >&2
    exit 1
    ;;
esac

if [ "$EMAIL" != "juniormind@proton.me" ] || [ "$NAME" != "Juniormind1" ]; then
  echo "ERROR: SatSage commits require local identity Juniormind1 <juniormind@proton.me>." >&2
  echo "Current: $NAME <$EMAIL>" >&2
  echo "Fix:" >&2
  echo "  git config user.name Juniormind1" >&2
  echo "  git config user.email juniormind@proton.me" >&2
  exit 1
fi

exit 0

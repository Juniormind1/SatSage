#!/bin/sh
# SatSage: refuse pushes that would publish non-Juniormind1 tip authorship.
# Activate once per clone: git config core.hooksPath githooks

set -e

remote="$1"
url="$2"

# Only guard pushes to GitHub SatSage remotes.
case "$url" in
  *Juniormind1/SatSage*|*juniormind1/satsage*) ;;
  *) exit 0 ;;
esac

while read -r local_ref local_sha remote_ref remote_sha
do
  [ -z "$local_sha" ] && continue
  # deleting a ref
  zeros=0000000000000000000000000000000000000000
  if [ "$local_sha" = "$zeros" ]; then
    continue
  fi

  name="$(git -c log.showSignature=false log -1 --format='%an' "$local_sha")"
  email="$(git -c log.showSignature=false log -1 --format='%ae' "$local_sha")"
  blob="$(printf '%s %s' "$name" "$email" | tr '[:upper:]' '[:lower:]')"

  case "$blob" in
    **|*\ *|*" "*|*@protonmail.com*)
      echo "ERROR: refusing push: tip commit uses personal identity ($name <$email>)." >&2
      echo "Rewrite before push, e.g.:" >&2
      echo "  git commit --amend --reset-author --no-edit" >&2
      echo "  (with user.name=Juniormind1 user.email=juniormind@proton.me)" >&2
      exit 1
      ;;
  esac

  if [ "$email" != "juniormind@proton.me" ] || [ "$name" != "Juniormind1" ]; then
    echo "ERROR: refusing push: tip author must be Juniormind1 <juniormind@proton.me>." >&2
    echo "Current tip: $name <$email> ($local_sha)" >&2
    exit 1
  fi
done

exit 0

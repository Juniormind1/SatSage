#!/bin/sh
# SatSage Maintainer-Hook (core.hooksPath=githooks):
# 1) Tip-Autor muss Juniormind1 sein (wie bisher)
# 2) Unit-Suite nur bei Push nach main (dev-juniormind = WIP, ohne Suite)
#
# Getestet wird der *gepushte* Stand (git worktree des local_sha), nicht der
# Arbeitsbaum — fremde, ungestagte Änderungen (parallele Worker) zählen nicht.
# Dauer: ~5½ min (2013 Tests, ~320 s). Ein schon grün getesteter SHA wird
# nicht noch einmal geprüft (Marke unter .git/satsage-gruen/).
# Ausnahme bewusst und sichtbar: SATSAGE_SKIP_TESTS=1 git push …
# (git push --no-verify überspringt den ganzen Hook, auch die Identität).

set -e

REQUIRED_NAME="Juniormind1"
REQUIRED_EMAIL="juniormind@proton.me"

remote="$1"
url="$2"

case "$url" in
  *Juniormind1/SatSage*|*juniormind1/satsage*) ;;
  *) exit 0 ;;
esac

zeros=0000000000000000000000000000000000000000
zu_testen=""

while read -r local_ref local_sha remote_ref remote_sha
do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$zeros" ] && continue   # Branch löschen: nichts zu prüfen

  name="$(git -c log.showSignature=false log -1 --format='%an' "$local_sha")"
  email="$(git -c log.showSignature=false log -1 --format='%ae' "$local_sha")"

  if [ "$email" != "$REQUIRED_EMAIL" ] || [ "$name" != "$REQUIRED_NAME" ]; then
    echo "ERROR: refusing push: tip author must be $REQUIRED_NAME <$REQUIRED_EMAIL>." >&2
    echo "Current tip: $name <$email> ($local_sha)" >&2
    echo "Rewrite before push, e.g.:" >&2
    echo "  git commit --amend --reset-author --no-edit" >&2
    exit 1
  fi
  # Unit-Suite nur nach main. Tags und WIP-Branches (dev-juniormind, …) ohne Lauf.
  case "$remote_ref" in
    refs/heads/main) zu_testen="$zu_testen $local_sha" ;;
  esac
done

[ -z "$zu_testen" ] && exit 0
if [ "${SATSAGE_SKIP_TESTS:-0}" = "1" ]; then
  echo "WARNUNG: SATSAGE_SKIP_TESTS=1 — Unit-Suite übersprungen." >&2
  exit 0
fi

wurzel="$(git rev-parse --show-toplevel)"
gitdir="$(git rev-parse --git-common-dir)"
py=""
for kandidat in \
  "$wurzel/.venv/bin/python" \
  "$wurzel/.venv/Scripts/python.exe"
do
  # Windows-Git setzt auf .exe oft kein +x — -f reicht, -x fängt Unix.
  if [ -x "$kandidat" ] || [ -f "$kandidat" ]; then
    py="$kandidat"
    break
  fi
done
if [ -z "$py" ]; then
  echo "ERROR: .venv Python fehlt (bin/python oder Scripts/python.exe) — Unit-Suite nicht lauffähig (SATSAGE_SKIP_TESTS=1 zum Übergehen)." >&2
  exit 1
fi
marken="$gitdir/satsage-gruen"
mkdir -p "$marken"

for sha in $(printf '%s\n' $zu_testen | sort -u); do
  [ -f "$marken/$sha" ] && { echo "pre-push: $sha schon grün getestet." >&2; continue; }
  baum="$(mktemp -d "${TMPDIR:-/tmp}/satsage-prepush.XXXXXX")"
  log="$baum.log"
  git worktree add --quiet --detach "$baum" "$sha"
  echo "pre-push: Unit-Suite auf ${sha%"${sha#???????}"} (~5½ min, Log: $log) …" >&2
  start=$(date +%s)
  set +e
  ( cd "$baum" && SATSAGE_HARD_TESTS=1 "$py" -m unittest discover -s tests -t . ) >"$log" 2>&1
  rc=$?
  set -e
  git worktree remove --force "$baum" >/dev/null 2>&1 || rm -rf "$baum"
  dauer=$(( $(date +%s) - start ))
  if [ "$rc" -ne 0 ]; then
    echo "ERROR: refusing push: Unit-Suite rot auf $sha (${dauer}s)." >&2
    grep -E '^(FAIL|ERROR):' "$log" | sed 's/^/  /' >&2 || true
    tail -n 3 "$log" | sed 's/^/  /' >&2
    exit 1
  fi
  echo "pre-push: grün ($(grep -E '^Ran ' "$log" | tail -n 1), ${dauer}s)." >&2
  : > "$marken/$sha"
  rm -f "$log"
done

exit 0

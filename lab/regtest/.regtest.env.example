# SatSage Regtest-Labor: nur Platzhalter bzw. lokale Lab-Defaults.
# Die generierte Datei liegt unter .data/.regtest.env und wird nicht versioniert.
WALLET_0_NAME=Lab Alpha
WALLET_0_XPUB=<regtest-tpub-alpha>
WALLET_1_NAME=Lab Beta
WALLET_1_XPUB=<regtest-tpub-beta>
WALLET_2_NAME=Lab Change
WALLET_2_XPUB=<regtest-tpub-change>
WALLET_3_NAME=Lab Gamma
WALLET_3_XPUB=<regtest-tpub-gamma>

NETWORK=regtest
FULCRUM_HOST=127.0.0.1
FULCRUM_PORT=50001
FULCRUM_SSL=false
BIP158_P2P=0
OEFFENTLICHE_ELECTRUM=0
NODE_IP=127.0.0.1
RPCPORT=18443
RPCUSER=bitcoin
RPCPASSWORD=secret

# Assistent (lokales Ollama, Loopback) — Host muss Ollama + Modell haben.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODELL=qwen2.5:0.5b
LLM_ANBIETER=ollama
LLM_BETRIEB=loopback
LLM_REMOTE_OPT_IN=0
MEMPOOL_URL=http://127.0.0.1:8080

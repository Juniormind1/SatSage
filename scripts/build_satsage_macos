#!/usr/bin/env bash
# Baut die SatSage-Web-GUI als macOS-Standalone (PyInstaller Onefile).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

PY="${PYTHON:-}"
if [[ -z "$PY" ]]; then
  if [[ -x "$ROOT/.venv/bin/python" ]]; then
    PY="$ROOT/.venv/bin/python"
  else
    PY="$(command -v python3 || command -v python)"
  fi
fi

echo "→ Python: $PY"
"$PY" -c "import sys; print('  ', sys.version.split()[0], sys.platform)"
if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "Hinweis: Dieses Skript ist für macOS gedacht (aktuell: $(uname -s))." >&2
fi

echo "→ Abhängigkeiten (requirements + pyinstaller + Pillow für Splash)…"
"$PY" -m pip install -q -r requirements.txt "pyinstaller>=6.0" "Pillow>=9.0"

# Splash-PNG optional (Linux/Windows-Builds nutzen es; macOS-Bootloader nicht).
echo "→ Marke und Splash (für Cross-Check / Linux-Win-Builds)…"
"$PY" "$ROOT/scripts/prepare_brand_assets.py" || true
"$PY" "$ROOT/scripts/make_splash.py" || true

echo "→ BTC-Preis-Bundle bis Tip (Bitstamp/CDD; SKIP_BTC_PRICE_REFRESH=1 zum Überspringen)…"
"$PY" "$ROOT/scripts/refresh_btc_price_bundle.py"

echo "→ Touch-ID-Hilfsprogramm (Swift, optional)…"
TOUCHID_DIR="$ROOT/build/touchid"
TOUCHID_OUT="$TOUCHID_DIR/satsage-touchid"
TOUCHID_STATUS="ohne Touch ID"
rm -rf "$TOUCHID_DIR"
unset SATSAGE_TOUCHID_BIN
if [[ "${SATSAGE_SKIP_TOUCHID:-0}" == "1" ]]; then
  echo "  übersprungen (SATSAGE_SKIP_TOUCHID=1) — Build ohne Touch ID."
elif [[ "$(uname -s)" != "Darwin" ]]; then
  echo "  kein macOS — Build ohne Touch ID."
elif ! command -v swiftc >/dev/null 2>&1; then
  echo "WARNUNG: swiftc fehlt (Xcode Command Line Tools: xcode-select --install) — Build ohne Touch ID." >&2
else
  mkdir -p "$TOUCHID_DIR"
  TOUCHID_TARGET="$(uname -m)-apple-macos${SATSAGE_TOUCHID_MIN_MACOS:-11.0}"
  if swiftc -O -swift-version 5 -target "$TOUCHID_TARGET" \
      -framework LocalAuthentication -framework Security \
      -o "$TOUCHID_OUT" "$ROOT/packaging/macos/satsage-touchid.swift"; then
    # Ad-hoc-Signatur (kein Developer-Konto). Der Schlüsselbund merkt sich
    # das Programm über diese Signatur.
    if codesign --force --sign - "$TOUCHID_OUT"; then
      export SATSAGE_TOUCHID_BIN="$TOUCHID_OUT"
      TOUCHID_STATUS="mit Touch ID ($TOUCHID_TARGET)"
      echo "  ok: build/touchid/satsage-touchid (ad-hoc signiert)"
    else
      echo "WARNUNG: codesign fehlgeschlagen — Build ohne Touch ID." >&2
    fi
  else
    echo "WARNUNG: swiftc fehlgeschlagen — Build ohne Touch ID." >&2
  fi
fi

echo "→ PyInstaller (Onefile; unter macOS ohne Splash-Bootloader)…"
export SATSAGE_BINARY_NAME=satsage-macos
rm -rf build/satsage-webgui dist/satsage-webgui "dist/${SATSAGE_BINARY_NAME}"
"$PY" -m PyInstaller --noconfirm --clean packaging/satsage-webgui.spec

OUT="$ROOT/dist/${SATSAGE_BINARY_NAME}"
if [[ ! -f "$OUT" ]]; then
  echo "Fehler: $OUT nicht erzeugt." >&2
  exit 1
fi
chmod +x "$OUT"
# Gatekeeper: lokaler Build ohne Notarisierung — Quarantäne entfernen, falls gesetzt.
xattr -dr com.apple.quarantine "$OUT" 2>/dev/null || true

if [[ -f "$ROOT/.env.example" ]]; then
  cp -f "$ROOT/.env.example" "$ROOT/dist/.env.example"
fi

echo
echo "Fertig."
echo "  Binary : $OUT"
echo "  Splash : unter macOS nicht im Bootloader (PyInstaller-Limit); Win/Linux ja"
echo "  TouchID: $TOUCHID_STATUS (Selbsttest: python3 scripts/touchid_selftest_macos.py)"
echo "  Start  : $OUT"
echo "  Config : .env neben dem Binary anlegen (Vorlage: dist/.env.example)"
echo "  Caches : utxo_cache/ und immutable_cache/ entstehen neben dem Binary"
echo "  Hinweis: Beim ersten Start ggf. Systemeinstellungen → Datenschutz → trotzdem öffnen."

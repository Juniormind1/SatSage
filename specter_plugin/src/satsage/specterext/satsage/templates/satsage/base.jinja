{% extends "base.jinja" %}

{% block main %}
<div class="card" style="max-width: 1100px; margin: 0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom: 1rem;">
        <img src="{{ url_for(service.id + '_endpoint.static', filename=service.icon) }}" width="36" height="36" alt="SatSage"/>
        <div>
            <h1 style="margin:0;">SatSage</h1>
            <p style="margin:0; opacity:0.8;">know your sats · Specter-Kontext → Herkunftsanalyse</p>
        </div>
    </div>

    <nav class="row" style="gap: 0.5rem; margin-bottom: 1.25rem; flex-wrap: wrap;">
        <a class="btn {% if active_tab == 'gui' %}action{% endif %}"
           href="{{ url_for(service.id + '_endpoint.gui') }}">Oberfläche</a>
        <a class="btn {% if active_tab == 'index' %}action{% endif %}"
           href="{{ url_for(service.id + '_endpoint.index') }}">Übersicht</a>
        <a class="btn {% if active_tab == 'wallets' %}action{% endif %}"
           href="{{ url_for(service.id + '_endpoint.wallets') }}">Wallets / XPUBs</a>
        <a class="btn {% if active_tab == 'analyze' %}action{% endif %}"
           href="{{ url_for(service.id + '_endpoint.analyze') }}">Analyse</a>
        <a class="btn"
           href="{{ url_for(service.id + '_endpoint.context_json') }}" target="_blank">context.json</a>
    </nav>

    {% block satsage_content %}{% endblock %}
</div>
{% endblock %}

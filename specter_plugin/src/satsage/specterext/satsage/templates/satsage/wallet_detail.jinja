{% extends "satsage/base.jinja" %}

{% block satsage_content %}
{% if error %}
    <p class="error">{{ error }}</p>
{% else %}
    <h2>{{ wallet_info.name }} <small>({{ wallet_info.alias }})</small></h2>
    <p>{{ wallet_info.description or '' }} · {{ wallet_info.address_type or '—' }}</p>

    <h3>XPUBs</h3>
    {% if wallet_info.xpubs %}
        <ul>
        {% for x in wallet_info.xpubs %}
            <li><code style="word-break: break-all;">{{ x }}</code></li>
        {% endfor %}
        </ul>
    {% else %}
        <p>—</p>
    {% endif %}

    <h3>UTXOs (via Specter-Wallet, max. Preview)</h3>
    {% if not utxos %}
        <p style="opacity:0.7;">Keine UTXOs.</p>
    {% else %}
        <table>
            <thead>
                <tr><th>txid:vout</th><th>Adresse</th><th>Betrag (BTC)</th><th>Conf</th><th></th></tr>
            </thead>
            <tbody>
            {% for u in utxos %}
                <tr>
                    <td><code>{{ u.txid }}:{{ u.vout }}</code></td>
                    <td><code>{{ u.address }}</code></td>
                    <td>{{ u.amount }}</td>
                    <td>{{ u.confirmations }}</td>
                    <td>
                        {% if u.txid is defined and u.vout is defined %}
                        <a class="btn" href="{{ url_for(service.id + '_endpoint.analyze', mode='utxo', utxo=u.txid ~ ':' ~ u.vout, address=u.address) }}">Trace</a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <h3 style="margin-top:1.5rem;">Transaktionen (via Specter-Wallet, max. Preview)</h3>
    {% if not txs %}
        <p style="opacity:0.7;">Keine Transaktionen.</p>
    {% else %}
        <table>
            <thead>
                <tr><th>txid</th><th>Kategorie</th><th>Betrag</th><th>Conf</th><th>Höhe</th></tr>
            </thead>
            <tbody>
            {% for t in txs %}
                <tr>
                    <td><code>{{ t.txid }}</code></td>
                    <td>{{ t.category }}</td>
                    <td>{{ t.amount }}</td>
                    <td>{{ t.confirmations }}</td>
                    <td>{{ t.blockheight }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endif %}
{% endblock %}
